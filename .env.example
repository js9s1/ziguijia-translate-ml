SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
FLASK_SECRET_KEY=your-random-secret-key

# daemon idle shutdown (°C) — idle daemons exit once the GPU reaches this temp
GEN_AUDIO_IDLE_TEMPERATURE=76
TRANSLATE_IDLE_TEMPERATURE=76
# gen_audio idle grace (s) — after every job the daemon ignores idle temp for this
# long, so back-to-back jobs reuse the warm model instead of reloading it
GEN_AUDIO_IDLE_GRACE_SECS=100
# translate prewarm grace (s) — a prewarmed model (ensure_model) ignores idle temp for this long
TRANSLATE_IDLE_GRACE_SECS=600
# critical temp (°C) — above this the grace is ignored and the daemon shuts down at once
GEN_AUDIO_IDLE_CRITICAL_TEMP=98
TRANSLATE_IDLE_CRITICAL_TEMP=98

# gen_audio step timeouts (seconds) — see run_gen_audio_step in pipeline.py
# GEN_AUDIO_STALL_TIMEOUT=900     # kill TTS subprocess after this long with no new log output
# GEN_AUDIO_SEGMENT_BUDGET=180    # total-cap budget per SRT segment
# GEN_AUDIO_MIN_TOTAL_TIMEOUT=7200  # total cap floor (max of the two applies)