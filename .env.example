SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
FLASK_SECRET_KEY=your-random-secret-key

# Chatterbox multilingual T3 checkpoint: v3 (default) or v2 (legacy)
# Restart the gen_audio daemon after changing this.
# CHATTERBOX_T3_MODEL=v3
# VoxCPM2 is used only for Cantonese (yue). Restart the daemon after changes.
# Defaults are tuned for the ning reference clip: 5.6 s prompt + transcript,
# CFG 2.0 and 10 diffusion steps (the settings VoxCPM2 ships its demos with).
# VOXCPM_MODEL=openbmb/VoxCPM2
# VOXCPM_CFG_VALUE=2.0
# VOXCPM_INFERENCE_TIMESTEPS=10
# VOXCPM_SEED=42
# VOXCPM_OPTIMIZE=0
# Hi-fi ("ultimate") cloning — pair a short clip with its exact transcript.
# Set VOXCPM_HIFI_CLONE=0 for plain reference-only cloning.
# VOXCPM_HIFI_CLONE=1
# VOXCPM_PROMPT_WAV=/home/you/子归家/assets/ning_prompt.wav
# VOXCPM_PROMPT_TEXT=梦里边还没醒之前，都是修证的一个过程啊，那个风景，路上的风景。
# Bad-case retries: audio/text ratio 2.0 (library default 6.0 fires too late
# for 1-2 s subtitle cues). Max 3 attempts per request.
# VOXCPM_RETRY_BADCASE=1
# VOXCPM_RETRY_RATIO=2.0
# daemon idle shutdown (°C) — idle daemons exit once the GPU reaches this temp
GEN_AUDIO_IDLE_TEMPERATURE=76
TRANSLATE_IDLE_TEMPERATURE=76
# gen_audio idle grace (s) — after every job the daemon ignores idle temp for this
# long, so back-to-back jobs reuse the warm model instead of reloading it
GEN_AUDIO_IDLE_GRACE_SECS=100
# translate prewarm grace (s) — a prewarmed model (ensure_model) ignores idle temp for this long
TRANSLATE_IDLE_GRACE_SECS=600
# critical temp (°C) — above this the grace is ignored and the daemon shuts down at once
GEN_AUDIO_IDLE_CRITICAL_TEMP=98
TRANSLATE_IDLE_CRITICAL_TEMP=98
# idle timeout (s) — after a job finishes, an idle daemon exits after this long
# even if it is cool (0 disables); back-to-back jobs cancel the countdown
GEN_AUDIO_IDLE_TIMEOUT_SECS=300
TRANSLATE_IDLE_TIMEOUT_SECS=300

# gen_audio step timeouts (seconds) — see run_gen_audio_step in pipeline.py
# GEN_AUDIO_STALL_TIMEOUT=900     # kill TTS subprocess after this long with no new log output
# GEN_AUDIO_SEGMENT_BUDGET=180    # total-cap budget per SRT segment
# GEN_AUDIO_MIN_TOTAL_TIMEOUT=7200  # total cap floor (max of the two applies)

# Whisper ASR backend — see run_whisper_ckpt in chatterbox-server/pipeline.py
# Primary is a whisper.cpp Vulkan build (fp32 + flash-attn). If it fails,
# the pipeline automatically retries with the CPU binary and 16 threads.
# WHISPER_BIN=/home/you/.local/opt/whisper.cpp-vulkan/whisper-cli
# WHISPER_LIB_DIR=/home/you/.local/opt/whisper.cpp-vulkan
# WHISPER_CPU_BIN=/usr/bin/whisper-cli
# WHISPER_CPU_THREADS=16
# WHISPER_MODEL=/home/you/.local/share/whisper-models/ggml-medium.bin
# WHISPER_OV_DEVICE=CPU
# GPU gate: skip Vulkan and use CPU while the GPU is at/above this temp, or
# while that many TTS/OCR/translate jobs are active (0 disables a check).
# WHISPER_GPU_MAX_TEMP=76
# WHISPER_GATE_TTS_ACTIVE=1
# WHISPER_GATE_OCR_ACTIVE=1
# WHISPER_GATE_TRANSLATE_ACTIVE=1
