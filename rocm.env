# Canonical ROCm environment for AMD Strix Halo APU (gfx1151 / Radeon 8060S)
# Single source of truth, shared by:
#   shell entrypoints  → source rocm_env.sh
#   Python entrypoints → from rocm_env import setup; setup()
#
# Key findings:
#   - ROCm 7.2.x has native support for gfx1151 — no GFX override needed
#   - Strix Halo iGPU uses UMA (unified memory), no VRAM limits to worry about
ROCM_LIB=/opt/rocm/rocm/lib
# ROCm 7.2 default (explicit for clarity).  With interrupt waits enabled,
# the HSA exception-monitor thread busy-polls ~1 core once a process has
# done GPU work (with it disabled, two threads poll instead).  The TTS
# daemon works around the idle burn by exiting after GEN_AUDIO_IDLE_TIMEOUT
# seconds without jobs; clients restart it on demand.
HSA_ENABLE_INTERRUPT=1
